# Python/cache + build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local environments and baseline checkouts
.venv/
.env
.external_baselines/
baseline_repos/*
!baseline_repos/README.md

# OMC runtime state (created if tooling is invoked with this repo as cwd).
# Recursive so nested .omc/ folders (e.g. under manuscript/) are also ignored.
.omc/
**/.omc/

# OS/editor cruft
**/.DS_Store
**/.vscode/
**/.idea/

# Dataset cache — raw counts + spatial metadata only; cards are tracked
data/raw/
data/processed/
!data/cards/

# Generated outputs
results/*
!results/README.md
manuscript/*.aux
manuscript/*.bbl
manuscript/*.blg
manuscript/*.log
manuscript/*.out
manuscript/*.pdf
